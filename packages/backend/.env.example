# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_PATH=./data/zottery.db

# Zcash RPC Configuration
# For testnet, use default testnet RPC port 18232
# For mainnet, use default mainnet RPC port 8232
ZCASH_RPC_URL=http://localhost:18232
ZCASH_RPC_USER=zcash
ZCASH_RPC_PASSWORD=your_rpc_password_here

# Lottery Transparent Address (where users send ticket payments)
# Generate this using: zcash-cli getnewaddress
LOTTERY_TRANSPARENT_ADDRESS=t1YourZcashTransparentAddressHere
