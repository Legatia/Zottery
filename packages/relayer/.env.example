# Starknet Configuration
STARKNET_RPC_URL=https://starknet-sepolia.public.blastapi.io
CLAIM_VERIFIER_ADDRESS=0x...  # Address of ClaimVerifier contract

# Zcash Configuration
ZCASH_RPC_URL=http://localhost:8232
ZCASH_RPC_USER=zcashrpc
ZCASH_RPC_PASSWORD=your_secure_password
VAULT_Z_ADDRESS=zs1...  # Vault's shielded address for sending prizes

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zottery_relayer
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration (optional, for job queue)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Relayer Settings
POLL_INTERVAL_MS=15000  # How often to check for new events
MAX_RETRIES=3  # Number of retries for failed payouts
