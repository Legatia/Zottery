# Zottery Testnet Configuration (Starknet Sepolia + Zcash Testnet)

# =========================
# Starknet Configuration
# =========================

# Starknet RPC
VITE_STARKNET_RPC_URL=https://starknet-sepolia.public.blastapi.io

# Contract Addresses (Fill in after deployment)
VITE_VAULT_ADDRESS=
VITE_LOTTERY_MANAGER_ADDRESS=
VITE_CLAIM_VERIFIER_ADDRESS=

# Testnet Tokens
VITE_USDC_ADDRESS=0x053c91253bc9682c04929ca02ed00b3e423f6710d2ee7e0d5ebb06f3ecf368a8

# =========================
# Relayer Configuration
# =========================

# Starknet
STARKNET_RPC_URL=https://starknet-sepolia.public.blastapi.io
CLAIM_VERIFIER_ADDRESS=

# Zcash Testnet
ZCASH_RPC_URL=http://localhost:18232
ZCASH_RPC_USER=zcashrpc
ZCASH_RPC_PASSWORD=your_testnet_password
VAULT_Z_ADDRESS=  # Testnet z-address (ztestsapling1...)

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zottery_relayer_testnet
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug
POLL_INTERVAL_MS=15000

# =========================
# Backend (Original Zcash-only)
# =========================

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_PATH=./data/zottery-testnet.db

# Zcash Testnet RPC
ZCASH_RPC_URL=http://localhost:18232
ZCASH_RPC_USER=zcash
ZCASH_RPC_PASSWORD=your_testnet_password

# Lottery Transparent Address (testnet)
LOTTERY_TRANSPARENT_ADDRESS=

# =========================
# Deployment Notes
# =========================

# 1. Deploy Starknet contracts:
#    cd packages/starknet-contracts
#    ./scripts/deploy.sh sepolia

# 2. Copy contract addresses to this file

# 3. Setup Zcash testnet node:
#    zcashd -testnet

# 4. Generate vault z-address:
#    zcash-cli -testnet z_getnewaddress sapling

# 5. Fund vault address:
#    Use testnet faucet: https://faucet.testnet.z.cash/

# 6. Start relayer:
#    cd packages/relayer
#    npm run dev

# 7. Start frontend:
#    cd packages/frontend
#    npm run dev
